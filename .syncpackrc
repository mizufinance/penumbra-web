{
  "sortFirst": [
    "name",
    "version",
    "private",
    "license",
    "description",
    "repository",
    "packageManager",
    "type",
    "main",
    "engine",
    "scripts",
    "files",
    "exports",
    "publishConfig",
    "pnpm"
  ],
  "dependencyTypes": [
    "dev",
    "peer",
    "pnpmOverrides",
    "prod"
  ],
  "semverGroups": [
    {
      "range": "^",
      "dependencies": [
        "@bufbuild/**",
        "@connectrpc/**"
      ],
      "packages": [
        "**"
      ]
    }
  ],
  "versionGroups": [
    {
      "label": "Use Tailwind v3 for older applications",
      "dependencies": ["tailwindcss"],
      "pinVersion": "3.4.17",
      "packages": [
        "@mizufinance/ui-deprecated",
        "@repo/tailwind-config",
        "minifront",
        "node-status"
      ]
    },
    {
      "label": "Use workspace protocol for local packages",
      "dependencies": [
        "$LOCAL"
      ],
      "pinVersion": "workspace:*"
    },
    {
      "label": "@types packages should only be under devDependencies",
      "dependencies": [
        "@types/**"
      ],
      "dependencyTypes": [
        "!dev"
      ],
      "isBanned": true
    },
    {
      "label": "Use @mizufinance/protobuf instead of a BSR dependency",
      "dependencies": [
        "@buf/mizufinance_shieldd.*"
      ],
      "isBanned": true
    },
    {
      "label": "Don't depend on BSR in published packages",
      "dependencies": [
        "@buf/*"
      ],
      "packages": [
        "@mizufinance/**"
      ],
      "isBanned": true
    }
  ]
}

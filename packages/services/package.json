{
  "name": "@mizufinance/services",
  "version": "69.0.0",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "engine": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rm -rfv dist *.tsbuildinfo package mizufinance-*.tgz",
    "dev:pack": "tsc-watch --onSuccess \"$npm_execpath pack\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "tsc --noEmit && eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./ctx/*": {
      "types": "./dist/ctx/*.d.ts",
      "default": "./dist/ctx/*.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/crypto-web": "workspace:*",
    "@mizufinance/getters": "workspace:*",
    "@mizufinance/protobuf": "workspace:*",
    "@mizufinance/storage": "workspace:*",
    "@mizufinance/transport-dom": "workspace:*",
    "@mizufinance/types": "workspace:*",
    "@mizufinance/wasm": "workspace:*",
    "@types/chrome": "^0.0.268"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.1",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/crypto-web": "workspace:*",
    "@mizufinance/getters": "workspace:*",
    "@mizufinance/protobuf": "workspace:*",
    "@mizufinance/storage": "workspace:*",
    "@mizufinance/transport-dom": "workspace:*",
    "@mizufinance/types": "workspace:*",
    "@mizufinance/wasm": "workspace:*"
  }
}

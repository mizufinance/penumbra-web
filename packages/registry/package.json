{
  "name": "@mizufinance/registry",
  "version": "12.8.0",
  "license": "(MIT OR Apache-2.0)",
  "description": "Chain and asset registry for Shieldd",
  "type": "module",
  "engine": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "gen:data": "cargo run --release --manifest-path gen/Cargo.toml",
    "clean": "rm -rfv dist *.tsbuildinfo package mizufinance-*.tgz",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "tsc --noEmit && eslint src --max-warnings 0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0"
  },
  "devDependencies": {
    "@mizufinance/protobuf": "workspace:*",
    "@tsconfig/strictest": "2.0.5",
    "typescript": "5.5.3"
  },
  "peerDependencies": {
    "@mizufinance/protobuf": "workspace:*"
  }
}

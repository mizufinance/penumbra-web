{
  "name": "@mizufinance/perspective",
  "version": "61.1.1",
  "license": "(MIT OR Apache-2.0)",
  "description": "Tools for assuming different perspectives of Shieldd transactions",
  "type": "module",
  "engine": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build --verbose",
    "clean": "rm -rfv dist *.tsbuildinfo package mizufinance-*.tgz",
    "dev:pack": "tsc-watch --onSuccess \"$npm_execpath pack\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:strict": "tsc --noEmit && eslint src --max-warnings 0",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "exports": {
    "./plan/*": {
      "types": "./dist/plan/*.d.ts",
      "default": "./dist/plan/*.js"
    },
    "./transaction/*": {
      "types": "./dist/transaction/*.d.ts",
      "default": "./dist/transaction/*.js"
    },
    "./translators/*": {
      "types": "./dist/translators/*.d.ts",
      "default": "./dist/translators/*.js"
    },
    "./action-view/*": {
      "types": "./dist/action-view/*.d.ts",
      "default": "./dist/action-view/*.js"
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/getters": "workspace:*",
    "@mizufinance/protobuf": "workspace:*"
  },
  "optionalDependencies": {
    "@mizufinance/wasm": "workspace:*"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@mizufinance/bech32m": "workspace:*",
    "@mizufinance/getters": "workspace:*",
    "@mizufinance/protobuf": "workspace:*"
  }
}
